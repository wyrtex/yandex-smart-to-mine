# OAuth-приложение Яндекса (oauth.yandex.ru) — нужно для входа в аккаунт из интерфейса
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
# Как часто опрашивать облако Яндекса, секунд
YANDEX_POLL_INTERVAL=10

# Пароль на интерфейс и API. Обязательно задайте, если сервер доступен из интернета
SMARTHOME_PASSWORD=
SMARTHOME_PORT=8000
TZ=Europe/Moscow

# Zigbee2MQTT (оставьте MQTT_HOST пустым, пока нет стика).
# В docker compose с профилем zigbee: MQTT_HOST=mosquitto
MQTT_HOST=
MQTT_PORT=1883
ZIGBEE_SERIAL_PORT=/dev/ttyUSB0
